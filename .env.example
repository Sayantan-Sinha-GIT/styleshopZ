# Paste the TLS connection string from your Neon dashboard.
DATABASE_URL=
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional providers. Demo checkout and guided assistant work without these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Only Razorpay TEST keys are accepted, and a webhook secret is required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Development seed only; never store a password in this example file.
ALLOW_DEMO_SEED=false
DEV_SEED_PASSWORD=
