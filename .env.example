# styleshopZ Environment Variables Checklist
# Add real secrets to .env.local (local development) and Vercel Project Settings (production).

# Database (Neon PostgreSQL connection string, pooled)
DATABASE_URL=postgresql://<user>:<pwd>@<host>/<database>?sslmode=require

# Razorpay Test Mode Credentials
# Get from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Shopping Assistant
# Google AI Studio free tier key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq free tier fallback key
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Authentication JWT secret (for session token signatures)
AUTH_SECRET=styleshopz-auth-secret-change-in-production

# App Version / Production URL
NEXT_PUBLIC_APP_URL=https://styleshopz.vercel.app
